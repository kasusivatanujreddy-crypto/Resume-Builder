# ==============================================================================
# CraftCV Studio - Environment Variables Template
# Copy this file to '.env' and replace placeholder values with your actual keys.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. BACKEND SETTINGS (Private - Never exposed to browser / client)
# ------------------------------------------------------------------------------
PORT=3000

# Google Gemini API Key
# Get your free key from Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# Supabase Service Role Key (OPTIONAL - Backend Admin Only)
# WARNING: Bypasses all Row-Level Security (RLS). NEVER put this in frontend code!
# SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY_HERE

# ------------------------------------------------------------------------------
# 2. FRONTEND SETTINGS REFERENCE
# (For the browser, enter these in: js/config.js)
# ------------------------------------------------------------------------------
# SUPABASE_URL=https://your-project-id.supabase.co
# SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
